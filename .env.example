# --- Database ---
# Example: postgresql+psycopg://user:pass@localhost:5433/policy
DATABASE_URL=

# --- Azure Storage (Blob) ---
AZURE_STORAGE_ACCOUNT_URL=
# Optional: AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_SAS_EXPIRY_MINUTES=30

# --- Azure Storage (Queue) ---
AZURE_POLICY_EXTRACTION_QUEUE_NAME=policy-extraction
AZURE_STORAGE_QUEUE_ACCOUNT_URL=

# --- Worker ---
AZURE_POLICY_EXTRACTED_CONTAINER=policy-extracted
WORKER_POLL_SECONDS=2
WORKER_VISIBILITY_TIMEOUT_SECONDS=60
WORKER_MAX_MESSAGES=8

# --- API ---
ENVIRONMENT=local
ENABLE_DOCS=true

# --- Database Backend (postgresql or cosmos) ---
# DB_BACKEND=postgresql
# For Cosmos DB NoSQL:
# COSMOS_ENDPOINT=https://<account>.documents.azure.com:443/
# COSMOS_KEY=<primary-key>
# COSMOS_DATABASE=policydb

# --- Phase 2.5 Embeddings + Hybrid Retrieval ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_EMBEDDINGS_DEPLOYMENT=
EMBEDDING_DIM=3072

# --- Phase 2.6 LLM Answer Generation ---
# Set to your Azure OpenAI chat/completion deployment name (e.g. gpt-4o).
# Without this, the system falls back to excerpt-only answers.
AZURE_OPENAI_CHAT_DEPLOYMENT=

RETRIEVER_BACKEND=hybrid
EMBEDDINGS_ENABLED=true
EMBEDDINGS_TOP_K=40
FTS_TOP_K=40

# --- Phase 2.7 Hybrid Retrieval Tuning ---
# Candidates fetched per source before merge (spec: 20 each)
HYBRID_SOURCE_TOP_K=20
# Fusion weights — must sum to 1.0
HYBRID_VECTOR_WEIGHT=0.45
HYBRID_FTS_WEIGHT=0.35
HYBRID_AUTHORITY_WEIGHT=0.15
HYBRID_RECENCY_WEIGHT=0.05
# Per-source minimum quality filters
HYBRID_VECTOR_MIN_SIMILARITY=0.65
HYBRID_FTS_MIN_SCORE=0.05
