# ---- App / Logging ----
LOG_LEVEL=INFO
ENVIRONMENT=local

# ---- Database (PostgreSQL) ----
# Example (local):
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/policy_platform
DATABASE_URL=postgresql+psycopg://policy:policy@localhost:5433/policy_platform

# ---- Azure Storage (Blob) ----
# Use one of:
# AZURE_STORAGE_ACCOUNT_URL=https://<account>.blob.core.windows.net
# AZURE_STORAGE_ACCOUNT_NAME=<account>
AZURE_STORAGE_ACCOUNT_URL=http://127.0.0.1:10000/devstoreaccount1
AZURE_STORAGE_ACCOUNT_NAME=devstoreaccount1

# Optional: shared key (prefer Managed Identity/Entra ID in prod)
AZURE_STORAGE_ACCOUNT_KEY=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==

# For Azurite compatibility (SDK otherwise may send a future x-ms-version)
AZURE_STORAGE_API_VERSION=2021-08-06

# SAS expiry for upload URLs
AZURE_STORAGE_SAS_EXPIRY_MINUTES=15

# ---- Azure Queue (Extraction Requests) ----
# Queue name used by ingestion -> worker
AZURE_POLICY_EXTRACTION_QUEUE_NAME=policy-extraction

# Prefer explicit queue account URL:
# AZURE_STORAGE_QUEUE_ACCOUNT_URL=https://<account>.queue.core.windows.net
AZURE_STORAGE_QUEUE_ACCOUNT_URL=http://127.0.0.1:10001/devstoreaccount1

# Worker output container for extracted artifacts
AZURE_POLICY_EXTRACTED_CONTAINER=policy-extracted

# Optional: container used for raw policy uploads in local demos
AZURE_POLICY_RAW_CONTAINER=policy-raw

# ---- Worker polling ----
WORKER_POLL_SECONDS=2
WORKER_VISIBILITY_TIMEOUT_SECONDS=60
WORKER_MAX_MESSAGES=8
