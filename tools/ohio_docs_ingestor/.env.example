API_BASE_URL=http://localhost:8000
TENANT_ID=00000000-0000-0000-0000-000000000001
SOURCE_SYSTEM=ohio-docs
AGENCY=DAS
JURISDICTION=ohio
DEFAULT_DEPARTMENT_SCOPE=all
DEFAULT_AUTHORITY_LEVEL=50
DEFAULT_POLICY_TYPE=external_policy
INCLUDE_EXTERNAL_REFERENCES=false
CONTAINER_NAME=policy-raw
